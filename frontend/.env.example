# Copy this file to .env (for local testing) and fill in a real value.
# For the actual Netlify deployment, set this same variable name in
# Netlify's dashboard instead (Site configuration -> Environment variables) -
# do NOT commit your real backend URL here if this repo is ever public.

# Your live Spring Boot backend's public URL (from Render, once deployed).
# Leave unset entirely for normal local development - it defaults to
# http://localhost:8080 automatically.
VITE_API_URL=https://your-backend-name.onrender.com
